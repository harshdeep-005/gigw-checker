# Copy this to .env and fill in values for local development.
# Never commit .env — it's in .gitignore.

DATABASE_URL=postgres://gigw:gigw@localhost:5432/gigw_checker
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Crawl defaults (can be overridden per-job via API)
CRAWL_DEPTH_CAP=5
CRAWL_PAGE_CAP=500
CRAWL_PAGE_TIMEOUT_MS=15000
CRAWL_PAGE_RETRIES=2
