{
  "name": "gigw-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/checkers/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "db:generate": "npm run db:generate --workspace=@gigw/db",
    "build": "tsc --build",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/checkers/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/checkers/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/checkers/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.4.0",
    "@typescript-eslint/parser": "8.4.0",
    "typescript-eslint": "8.4.0",
    "eslint": "9.9.1",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
